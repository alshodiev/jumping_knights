# Copy to .env and fill in. NEVER commit .env.
PORT=8787
# Comma-separated list of sites allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

# Claude (optional: without it the greeting uses a built-in question)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Telegram (optional in dev: without it, a mock coach endpoint is used)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_COACH_USER_ID=

# Contact-form messages all go to one topic with this name (created automatically)
TELEGRAM_CLIENTS_TOPIC_NAME=Potential Clients
# Optional: id of an existing topic to use instead (leave empty to auto-create)
TELEGRAM_CLIENTS_THREAD_ID=

# Seconds the visitor waits for you before the follow-up fallback (default 300 = 5 min)
COACH_REPLY_TIMEOUT_SECONDS=300

# ---- Private videos (see DEPLOY.md) ----
# Coach sign-in. Make the hash with:  npm run hash-password   (paste the whole COACH_PASSWORD_HASH=... line)
COACH_USERNAME=coach
COACH_PASSWORD_HASH=
# Random secret that signs the coach cookie. Make one with:  openssl rand -hex 32
SESSION_SECRET=
# Cloudflare R2 (where the videos live). Leave empty in development: videos then go to ./data/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional
MAX_VIDEO_MB=1024
VIDEO_LINK_TTL_SECONDS=1800

